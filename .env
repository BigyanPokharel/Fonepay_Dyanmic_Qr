
# Fonepay production credentials (provided by your bank)
FONEPAY_MERCHANT_CODE=your_merchant_code
FONEPAY_SECRET_KEY=your_secret_key
FONEPAY_USERNAME=your_username
FONEPAY_PASSWORD=your_password

# Fonepay API base (production – do not change unless instructed)
FONEPAY_BASE_URL=https://merchantapi.fonepay.com/api

# MongoDB connection (local or Atlas)
MONGODB_URI_FONEPAY=mongodb://localhost:27017/fonepay_qr

# Server port (default 3000)
PORT=3000
